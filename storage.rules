rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn() &&
        (
          request.auth.token.admin == true ||
          request.auth.token.role == 'admin'
        );
    }

    function canManageSupport() {
      return signedIn() &&
        (
          request.auth.token.admin == true ||
          request.auth.token.role in ['admin', 'super_admin', 'support_officer']
        );
    }

    function isImage() {
      return request.resource != null &&
        request.resource.contentType != null &&
        request.resource.contentType.matches('image/(jpeg|jpg|png|webp)');
    }

    function isVerificationDocument() {
      return request.resource != null &&
        request.resource.contentType != null &&
        (
          request.resource.contentType.matches(
            'image/(jpeg|jpg|png|webp)'
          ) ||
          request.resource.contentType == 'application/pdf'
        );
    }

    function uploadEligibleAccount(userId) {
      return firestore.exists(
        /databases/(default)/documents/users/$(userId)
      ) && firestore.get(
        /databases/(default)/documents/users/$(userId)
      ).data.accountStatus in ['pendingProfile', 'active'];
    }

    match /profile_photos/{userId}/{fileName} {
      allow read: if signedIn();

      allow create: if isOwner(userId) &&
        uploadEligibleAccount(userId) &&
        request.resource.size > 0 &&
        request.resource.size <= 5 * 1024 * 1024 &&
        isImage();

      allow update: if false;

      allow delete: if isOwner(userId) || isAdmin();
    }

    match /verification_documents/{userId}/{fileName} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId) &&
        uploadEligibleAccount(userId) &&
        request.resource.size > 0 &&
        request.resource.size <= 10 * 1024 * 1024 &&
        isVerificationDocument();

      allow update, delete: if false;
    }

    match /support_attachments/{userId}/{draftId}/{fileName} {
      allow read: if isOwner(userId) || canManageSupport();

      allow create: if isOwner(userId) &&
        uploadEligibleAccount(userId) &&
        request.resource.size > 0 &&
        request.resource.size <= 5 * 1024 * 1024 &&
        isImage();

      allow update: if false;
      allow delete: if isOwner(userId) || canManageSupport();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
